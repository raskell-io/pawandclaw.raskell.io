// Cloudflare Worker serving the static site (public/), the game included at /play/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paw-and-claw-raskell-io",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "paw-and-claw.raskell.io", "custom_domain": true }
  ],
  "workers_dev": false,
  "observability": { "enabled": true }
}
